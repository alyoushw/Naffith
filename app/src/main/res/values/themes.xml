<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- هوية «مرسال»: داكنة، وألوان الكرة الصوتية (أزرق ← بنفسجي ← وردي ← فيروزي). -->
    <color name="bg">#0A0C12</color>
    <color name="bg_top">#121626</color>
    <color name="surface">#161A24</color>
    <color name="surface_card">#1D2230</color>
    <color name="surface_stroke">#2A3042</color>
    <color name="text_primary">#F2F4FA</color>
    <color name="text_secondary">#9AA3B8</color>
    <color name="brand">#8B6CFF</color>
    <color name="brand_dark">#5B3FD9</color>
    <color name="orb_blue">#4F8BFF</color>
    <color name="orb_violet">#9B5CFF</color>
    <color name="orb_pink">#FF5CA8</color>
    <color name="orb_teal">#3DD9C5</color>
    <color name="listening">#FF5C8A</color>
    <color name="white">#FFFFFF</color>

    <style name="Theme.Naffith" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondaryContainer">@color/surface_stroke</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- شاشة الإعدادات -->
    <style name="SettingsTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- نافذة المساعد: شفافة، والخلفية معتّمة، والبطاقة تطلع من تحت. -->
    <style name="Theme.Naffith.Popup" parent="Theme.Naffith">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
</resources>
