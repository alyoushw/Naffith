<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- الشريط العلوي: الاسم والإعدادات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_description"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- الكرة الصوتية: اضغطها وتكلم -->
        <com.naffith.app.VoiceOrbView
            android:id="@+id/orbView"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/mic_description" />

        <TextView
            android:id="@+id/transcriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:minHeight="64dp"
            android:text="@string/transcript_placeholder"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="@string/status_ready"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- جواب السوالف: يبقى ظاهر لين تسأل شي ثاني. -->
        <TextView
            android:id="@+id/answerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="5dp"
            android:padding="18dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="17sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_mic_idle"
            android:contentDescription="@string/mic_description"
            android:elevation="10dp"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tap_to_talk"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:text="@string/examples"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
