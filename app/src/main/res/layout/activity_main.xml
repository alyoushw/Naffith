<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/brand"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/transcriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:minHeight="120dp"
            android:padding="20dp"
            android:text="@string/transcript_placeholder"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/status_ready"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_mic_idle"
            android:contentDescription="@string/mic_description"
            android:elevation="8dp"
            android:padding="40dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/handsFreeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/hf_switch"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/examples"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
