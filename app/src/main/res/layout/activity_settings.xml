<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/SettingsTitle"
            android:text="@string/settings_title" />

        <!-- الأسماء الثانية -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/aliases_title" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/aliases_hint" />

            <LinearLayout
                android:id="@+id/aliasList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/aliasEmpty"
                style="@style/SettingsHint"
                android:text="@string/aliases_empty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addAliasButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/aliases_add" />
        </LinearLayout>

        <!-- المساعد بدون مايك دائم -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/assistant_title" />

            <TextView
                android:id="@+id/assistantStatus"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assistantButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_button" />
        </LinearLayout>

        <!-- الصوت -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/voice_title" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/speakSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/speak_switch"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/voiceCurrent"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/voice_choose" />
        </LinearLayout>

        <!-- حساسية يا نفّذ -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/sensitivity_title" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/sensitivity_hint" />

            <RadioGroup
                android:id="@+id/sensitivityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/sensitivityNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sensitivity_normal" />

                <RadioButton
                    android:id="@+id/sensitivityHigh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sensitivity_high" />

                <RadioButton
                    android:id="@+id/sensitivityMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sensitivity_max" />
            </RadioGroup>
        </LinearLayout>

        <!-- الإرسال التلقائي -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/a11y_title" />

            <TextView
                android:id="@+id/a11yStatus"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/a11yButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
