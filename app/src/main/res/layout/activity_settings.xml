<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/SettingsTitle"
            android:text="@string/settings_title" />

        <!-- التحديثات -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/upd_section" />

            <TextView
                android:id="@+id/versionText"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdateButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/upd_check_button" />
        </LinearLayout>

        <!-- الاختصارات -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/sc_title" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/sc_hint" />

            <LinearLayout
                android:id="@+id/shortcutList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/shortcutEmpty"
                style="@style/SettingsHint"
                android:text="@string/sc_empty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addShortcutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sc_add" />
        </LinearLayout>

        <!-- الأسماء الثانية -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/aliases_title" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/aliases_hint" />

            <LinearLayout
                android:id="@+id/aliasList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/aliasEmpty"
                style="@style/SettingsHint"
                android:text="@string/aliases_empty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addAliasButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/aliases_add" />
        </LinearLayout>

        <!-- البيت والدوام -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/places_title" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/places_hint" />

            <TextView
                android:id="@+id/homeStatus"
                style="@style/SettingsHint" />

            <EditText
                android:id="@+id/homeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/places_home_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:textDirection="ltr" />

            <TextView
                android:id="@+id/workStatus"
                style="@style/SettingsHint" />

            <EditText
                android:id="@+id/workInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/places_work_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:textDirection="ltr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/placesSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/chat_save" />
        </LinearLayout>

        <!-- السوالف مع Gemini -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/chat_title" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/answer_mode_hint" />

            <RadioGroup
                android:id="@+id/answerModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/modeAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_auto" />

                <RadioButton
                    android:id="@+id/modeInApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_in_app" />

                <RadioButton
                    android:id="@+id/modeGeminiApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_gemini_app" />

                <RadioButton
                    android:id="@+id/modeGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_google" />

                <RadioButton
                    android:id="@+id/modeAsk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_ask" />
            </RadioGroup>

            <TextView
                android:id="@+id/chatStatus"
                style="@style/SettingsHint" />

            <EditText
                android:id="@+id/chatKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:hint="@string/chat_key_hint"
                android:inputType="textPassword"
                android:textDirection="ltr" />

            <EditText
                android:id="@+id/chatModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/chat_model_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textDirection="ltr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/chat_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatGetKey"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_get_key" />
        </LinearLayout>

        <!-- المساعد بدون مايك دائم -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/assistant_title" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/openAsAssistantSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/open_as_assistant_switch"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/assistantStatus"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assistantButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_button" />
        </LinearLayout>

        <!-- الصوت -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/voice_title" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/speakSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/speak_switch"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/patience_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/patience_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/patienceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/patienceShort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/patience_short"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/patienceMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/patience_medium"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/patienceLong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/patience_long"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:id="@+id/voiceCurrent"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/voice_choose" />
        </LinearLayout>


        <!-- الإرسال التلقائي -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/a11y_title" />

            <TextView
                android:id="@+id/a11yStatus"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/a11yButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
