<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/popupCard"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/bg_popup"
        android:elevation="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="14dp"
        android:paddingBottom="22dp">

        <!-- الاسم والإعدادات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_description"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <com.naffith.app.VoiceOrbView
            android:id="@+id/orbView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="@string/mic_description" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/hf_greeting"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/transcriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:minHeight="28dp"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <!-- جواب السوالف: يبقى ظاهر لين تسأل شي ثاني. -->
        <TextView
            android:id="@+id/answerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="5dp"
            android:maxLines="9"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- المايك والأزرار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:gravity="center"
            android:minHeight="72dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/screenButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/ask_screen"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/bg_mic_idle"
                android:contentDescription="@string/mic_description"
                android:elevation="8dp"
                android:padding="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/geminiButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/ask_gemini"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
